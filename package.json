{
  "name": "info-quality-baseline",
  "private": true,
  "version": "1.0.0",
  "description": "Dependency-free quality baseline for himiyosh/Info",
  "scripts": {
    "check:js": "node --check i18n.js && node --check script.js",
    "test:quality": "node --test tests/quality/*.test.mjs",
